{
  "name": "webnim",
  "version": "0.1.0",
  "description": "Interactive mathematical scenes for the web: declarative JSON, 2D and 3D rendering, draggable geometry and deterministic animations.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "fixtures",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/style.css": "./dist/react/style.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./browser": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./scene-v1.schema.json": "./dist/document/scene-v1.schema.json",
    "./browser/style.css": "./dist/player/style.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs",
    "demo": "npm run build && npm --prefix demo install --ignore-scripts && npm --prefix demo run build && npm --prefix demo start",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --access=public",
    "publish:github": "node scripts/publish-github.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.8",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "katex": "^0.18.7",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idadwind1/webnim.git"
  },
  "homepage": "https://github.com/idadwind1/webnim/wiki",
  "bugs": {
    "url": "https://github.com/idadwind1/webnim/issues"
  },
  "keywords": [
    "math",
    "animation",
    "visualization",
    "interactive",
    "canvas",
    "threejs",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
